
@using Microsoft.AspNetCore.Identity
@using ClientMonitoring.Web.Domain.Identity

@inject SignInManager<ClientMonitoring.Web.Domain.Identity.AppUser> SignInManager
@inject UserManager<ClientMonitoring.Web.Domain.Identity.AppUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link">
                Bonjour @UserManager.GetUserName(User)
            </span>
        </li>

        <li class="nav-item">
            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link btn btn-link">
                    Déconnexion
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Account"
               asp-action="Login">
                Connexion
            </a>
        </li>
    }
</ul>
