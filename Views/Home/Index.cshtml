@{
ViewData["Title"]="Client Monitoring";
}
<div class="container-fluid py-4">
<div class="d-flex justify-content-between">
<h1>Client Monitoring</h1>
<form asp-controller="Account" asp-action="Logout" method="post">
<button class="btn btn-outline-secondary">Logout</button>
</form></div><div class="row g-3 my-3">
<div class="col-md-3">
<div class="card">
<div class="card-body">
Total <b id="total">0</b>
</div></div></div>
<div class="col-md-3">
<div class="card">
<div class="card-body">
Online <b id="online" class="text-success">0</b>
</div></div></div><div class="col-md-3">
<div class="card">
<div class="card-body">
Offline <b id="offline" class="text-danger">0</b>
</div>
</div>
</div>
<div class="col-md-3">
<div class="card">
<div class="card-body">
Network problems <b id="problems" class="text-warning">0</b>
</div>
</div>
</div>
</div>
<div class="card">
<div class="table-responsive">
<table class="table table-hover mb-0">
<thead>
<tr>
<th>Client</th>
<th>Status</th>
</tr>
</thead>
<tbody id="clientsBody">
</tbody>
</table>
</div>
</div>
</div>
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script src="~/js/monitoring.js"></script>
}
